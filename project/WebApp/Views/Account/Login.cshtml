@using App.Domain
@model WebApp.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = (new LangStr { ["en"] = "Login", ["et"] = "Logi sisse" }).Translate();
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Email" class="form-label">@((new LangStr { ["en"] = "Email", ["et"] = "E-post" }).Translate())</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@((new LangStr { ["en"] = "Password", ["et"] = "Parool" }).Translate())</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">@((new LangStr { ["en"] = "Remember me", ["et"] = "Pea mind meeles" }).Translate())</label>
    </div>

    <button type="submit" class="btn btn-primary">@((new LangStr { ["en"] = "Login", ["et"] = "Logi sisse" }).Translate())</button>
</form>

<p class="mt-3">
    @((new LangStr { ["en"] = "No account yet?", ["et"] = "Pole veel kontot?" }).Translate())
    <a asp-controller="Account" asp-action="Register">@((new LangStr { ["en"] = "Register", ["et"] = "Registreeri" }).Translate())</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

