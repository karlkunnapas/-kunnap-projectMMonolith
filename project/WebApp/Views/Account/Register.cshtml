@model WebApp.ViewModels.Account.CustomerRegisterViewModel
@{
    var title = App.Resources.Views.Account.Register.Title;
    var companyRegisterUrl = Model.CompanyRegisterUrl;
}

<h1>@title</h1>

<p>
    @App.Resources.Views.Account.Register.NeedCompanyAccount
    @if (!string.IsNullOrWhiteSpace(companyRegisterUrl))
    {
        <a href="@companyRegisterUrl">@App.Resources.Views.Account.Register.RegisterCompany</a>
    }
</p>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label">@App.Resources.Views.Account.Register.FirstName</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label">@App.Resources.Views.Account.Register.LastName</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">@App.Resources.Views.Account.Register.Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label">@App.Resources.Views.Account.Register.Phone</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@App.Resources.Views.Account.Register.Password</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">@App.Resources.Views.Account.Register.ConfirmPassword</label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@App.Resources.Views.Account.Register.Submit</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
