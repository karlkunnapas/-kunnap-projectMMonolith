@using App.Domain
@using App.Domain.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="app-nav-item">
        <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@App.Resources.Views.Shared._Layout.Hello @User.Identity?.Name!</a>
    </li>
    <li class="app-nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="app-nav-link-button">@App.Resources.Views.Shared._Layout.Logout</button>
        </form>
    </li>
}
else
{
    <li class="app-nav-item">
        <a asp-area="" asp-controller="Account" asp-action="Register">@App.Resources.Views.Shared._Layout.Register</a>
    </li>
    <li class="app-nav-item">
        <a asp-area="Company" asp-controller="Account" asp-action="Register">@((new LangStr { ["en"] = "Register company", ["et"] = "Registreeri ettevote" }).Translate())</a>
    </li>
    <li class="app-nav-item">
        <a asp-area="" asp-controller="Account" asp-action="Login">@App.Resources.Views.Shared._Layout.Login</a>
    </li>
}
