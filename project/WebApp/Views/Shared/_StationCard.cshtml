@model WebApp.ViewModels.HomeStationViewModel
@using App.Domain

@{
    var companySlug = ViewContext.RouteData.Values["companySlug"]?.ToString();

    var statusText = Model.Status switch
    {
        EStationStatus.Available => App.Resources.Views.Home.Index.StatusAvailable,
        EStationStatus.InUse => App.Resources.Views.Home.Index.StatusInUse,
        _ => App.Resources.Views.Home.Index.StatusUnavailable
    };

    var statusClass = Model.Status switch
    {
        EStationStatus.Available => "status-ok",
        EStationStatus.InUse => "status-warn",
        _ => "status-bad"
    };

    var compatibilityText = Model.IsCompatibleWithSelectedVehicle switch
    {
        true => App.Resources.Views.Home.Index.Compatible,
        false => App.Resources.Views.Home.Index.Incompatible,
        _ => string.Empty
    };
}

<div class="station-card">
    <div class="station-icon">📍</div>
    <div class="station-details">
        <div class="station-name">@Model.Name</div>
        <div class="station-meta">📍 @Model.Location | @App.Resources.Views.Home.Index.Supported: @string.Join(", ", Model.ConnectorNames)</div>
        <div class="station-status @statusClass">
            @statusText | €@Model.PricePerKwh.ToString("0.00")/kWh | @App.Resources.Views.Home.Index.MaxPower: @Model.MaxPower.ToString("0")kW
        </div>
        @if (!string.IsNullOrWhiteSpace(compatibilityText))
        {
            <div class="station-status">
                @compatibilityText
            </div>
        }
    </div>
    <div class="station-actions">
        @if (User.IsInRole("CompanyOwner") && !string.IsNullOrWhiteSpace(companySlug))
        {
            <a class="station-button" asp-route="tenant-station-public" asp-route-id="@Model.Id" asp-route-companySlug="@companySlug">@App.Resources.Views.Home.Index.Details</a>
        }
        else
        {
            <a class="station-button" asp-area="Root" asp-controller="Station" asp-action="Details" asp-route-id="@Model.Id">@App.Resources.Views.Home.Index.Details</a>
        }
    </div>
</div>
