@using System.Threading
@using System.Security.Claims
@using App.Domain
@using App.DAL.EF
@using Microsoft.EntityFrameworkCore
@using WebApp.Helpers
@inject AppNameService AppNameService;
@inject ITenantContext TenantContext;
@inject AppDbContext DbContext;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("HeaderScripts", required: false)
</head>
<body>
<div class="app-shell">
    @{
        var isCompanyUser = false;
        ECompanyRole? currentCompanyRole = null;
        var canAccessManagerFeatures = false;
        var canManageUsers = false;
        var companySlugFromRoute = Context.Request.RouteValues["companySlug"]?.ToString();
        var companySlugFromQuery = Context.Request.Query["companySlug"].ToString();
        var currentCompanySlug = !string.IsNullOrWhiteSpace(companySlugFromRoute)
            ? companySlugFromRoute
            : (!string.IsNullOrWhiteSpace(companySlugFromQuery) ? companySlugFromQuery : TenantContext.CompanySlug);

        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (User.Identity?.IsAuthenticated == true && Guid.TryParse(userIdClaim, out var currentUserId))
        {
            var memberships = await DbContext.AppUserCompanies
                .AsNoTracking()
                .Include(uc => uc.Company)
                .Where(uc => uc.AppUserId == currentUserId && uc.IsActive)
                .OrderByDescending(uc => uc.JoinedAtUtc)
                .ToListAsync();

            isCompanyUser = memberships.Count > 0;
            if (isCompanyUser)
            {
                var currentMembership = !string.IsNullOrWhiteSpace(currentCompanySlug)
                    ? memberships.FirstOrDefault(uc => string.Equals(uc.Company?.Slug, currentCompanySlug, StringComparison.OrdinalIgnoreCase))
                    : null;

                currentMembership ??= TenantContext.CompanyId.HasValue
                    ? memberships.FirstOrDefault(uc => uc.CompanyId == TenantContext.CompanyId.Value)
                    : null;

                currentMembership ??= memberships.First();

                currentCompanyRole = currentMembership.Role;
                currentCompanySlug = currentMembership.Company?.Slug ?? currentCompanySlug;
                canAccessManagerFeatures = currentCompanyRole.Value >= ECompanyRole.Manager;
                canManageUsers = currentCompanyRole == ECompanyRole.Owner;
            }
        }
    }
    <aside class="app-sidebar">
        <div class="app-brand">
            @if (isCompanyUser)
            {
                @if (canAccessManagerFeatures)
                {
                    <a asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@AppNameService.AppName</a>
                }
                else
                {
                    <a asp-area="Company" asp-controller="Maintenance" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@AppNameService.AppName</a>
                }
            }
            else
            {
                <a asp-area="" asp-controller="Home" asp-action="Index">@AppNameService.AppName</a>
            }
        </div>
        <nav class="app-nav">
            <ul class="app-nav-list">
                <li class="app-nav-item">
                    @if (isCompanyUser)
                    {
                        @if (canAccessManagerFeatures)
                        {
                            <a asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.Home</a>
                        }
                        else
                        {
                            <a asp-area="Company" asp-controller="Maintenance" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.Home</a>
                        }
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Index">@App.Resources.Views.Shared._Layout.Home</a>
                    }
                </li>
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("root")))
                {
                    <li class="app-nav-item app-admin-group">
                        <details>
                            <summary>@App.Resources.Views.Shared._Layout.Admin</summary>
                            <ul class="app-admin-list">
                                 <li><a asp-area="Admin" asp-controller="Companies" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminCompanies</a></li>
                                <li><a asp-area="Admin" asp-controller="AppUsers" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminAppUsers</a></li>
                                 <li><a asp-area="Admin" asp-controller="AppUserCompanies" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminAppUserCompanies</a></li>
                                <li><a asp-area="Admin" asp-controller="ChargingStations" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminChargingStations</a></li>
                                <li><a asp-area="Admin" asp-controller="ChargingStationConnectors" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminStationConnectors</a></li>
                                <li><a asp-area="Admin" asp-controller="ChargingSessions" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminChargingSessions</a></li>
                                <li><a asp-area="Admin" asp-controller="Connectors" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminConnectors</a></li>
                                <li><a asp-area="Admin" asp-controller="Vehicles" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminVehicles</a></li>
                                <li><a asp-area="Admin" asp-controller="VehicleConnectors" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminVehicleConnectors</a></li>
                                <li><a asp-area="Admin" asp-controller="Reservations" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminReservations</a></li>
                                <li><a asp-area="Admin" asp-controller="Promotions" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminPromotions</a></li>
                                <li><a asp-area="Admin" asp-controller="UserPromotions" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminUserPromotions</a></li>
                                <li><a asp-area="Admin" asp-controller="Maintenances" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminMaintenances</a></li>
                                <li><a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">@App.Resources.Views.Shared._Layout.AdminAuditLogs</a></li>
                            </ul>
                        </details>
                    </li>
                }
                <li class="app-nav-item">
                    @if (isCompanyUser)
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.FindStations</a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Index">@App.Resources.Views.Shared._Layout.FindStations</a>
                    }
                </li>
                @if (User.IsInRole("Customer") && !isCompanyUser)
                {
                    <li class="app-nav-item">
                        <a asp-area="Root" asp-controller="Reservation" asp-action="Index">@App.Resources.Views.Shared._Layout.MyReservations</a>
                    </li>
                    <li class="app-nav-item">
                        <a asp-area="Root" asp-controller="ChargingSession" asp-action="History">@App.Resources.Views.Shared._Layout.MySessions</a>
                    </li>
                    <li class="app-nav-item">
                        <a asp-area="Root" asp-controller="Vehicle" asp-action="Index">@App.Resources.Views.Shared._Layout.MyVehicles</a>
                    </li>
                    <li class="app-nav-item">
                        <a asp-area="Root" asp-controller="Promotion" asp-action="Index">@App.Resources.Views.Shared._Layout.MyPromotions</a>
                    </li>
                }
                @if (isCompanyUser)
                {
                    <li class="app-nav-item">
                        <a asp-area="Company" asp-controller="Maintenance" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyMaintenance</a>
                    </li>
                    @if (canAccessManagerFeatures)
                    {
                        <li class="app-nav-item">
                            <a asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyDashboard</a>
                        </li>
                        <li class="app-nav-item">
                            <a asp-area="Company" asp-controller="Station" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyStations</a>
                        </li>
                        <li class="app-nav-item">
                            <a asp-area="Company" asp-controller="Promotion" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyPromotions</a>
                        </li>
                        <li class="app-nav-item">
                            <a asp-area="Company" asp-controller="Audit" asp-action="CompanyLog" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyAudit</a>
                        </li>
                    }
                    @if (canManageUsers)
                    {
                        <li class="app-nav-item">
                            <a asp-area="Company" asp-controller="CompanyUsers" asp-action="Index" asp-route-companySlug="@currentCompanySlug">@App.Resources.Views.Shared._Layout.CompanyUsers</a>
                        </li>
                    }
                    <li class="app-nav-item">
                        <a asp-area="" asp-controller="Account" asp-action="CompanySelection" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@App.Resources.Views.Shared._Layout.SwitchCompany</a>
                    </li>
                }
            </ul>
        </nav>
        <div class="app-sidebar-footer">
            <ul class="app-nav-list">
                <partial name="_LanguageSelection"/>
                <partial name="_LoginPartial"/>
            </ul>
        </div>
    </aside>
    <div class="app-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="border-top footer text-muted">
            <div class="container">
                @AppNameService.AppName - <a asp-area="" asp-controller="Home" asp-action="Privacy">@App.Resources.Views.Shared._Layout.Privacy</a> | 
                <a href="/swagger">Api</a> | 
                @Thread.CurrentThread.CurrentCulture.Name
            </div>
        </footer>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/htmx.org/dist/htmx.min.js"></script>
<script src="~/lib/alpinejs/dist/cdn.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
