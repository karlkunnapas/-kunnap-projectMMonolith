@using System.Threading
@using WebApp.Helpers
@inject AppNameService AppNameService;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("HeaderScripts", required: false)
</head>
<body>
<div class="app-shell">
    <aside class="app-sidebar">
        <div class="app-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">@AppNameService.AppName</a>
        </div>
        <nav class="app-nav">
            <ul class="app-nav-list">
                <li class="app-nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index">@App.Resources.Views.Shared._Layout.Home</a>
                </li>
                <li class="app-nav-item">
                    <a href="#">@((new App.Domain.LangStr { ["en"] = "Find Stations", ["et"] = "Leia jaamad" }).Translate())</a>
                </li>
                <li class="app-nav-item">
                    <a href="#">@((new App.Domain.LangStr { ["en"] = "My Reservations", ["et"] = "Minu broneeringud" }).Translate())</a>
                </li>
                <li class="app-nav-item">
                    <a href="#">@((new App.Domain.LangStr { ["en"] = "My Vehicles", ["et"] = "Minu soidukid" }).Translate())</a>
                </li>
                <li class="app-nav-item">
                    <a href="#">@((new App.Domain.LangStr { ["en"] = "Payment Methods", ["et"] = "Makselahendused" }).Translate())</a>
                </li>
                <li class="app-nav-item">
                    <a href="#">@((new App.Domain.LangStr { ["en"] = "Settings", ["et"] = "Seaded" }).Translate())</a>
                </li>
            </ul>
        </nav>
        <div class="app-sidebar-footer">
            <ul class="app-nav-list">
                <partial name="_LanguageSelection"/>
                <partial name="_LoginPartial"/>
            </ul>
        </div>
    </aside>
    <div class="app-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="border-top footer text-muted">
            <div class="container">
                @AppNameService.AppName - <a asp-area="" asp-controller="Home" asp-action="Privacy">@App.Resources.Views.Shared._Layout.Privacy</a> | 
                <a href="/swagger">Api</a> | 
                @Thread.CurrentThread.CurrentCulture.Name
            </div>
        </footer>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/htmx.org/dist/htmx.min.js"></script>
<script src="~/lib/alpinejs/dist/cdn.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
