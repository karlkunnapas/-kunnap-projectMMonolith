@model WebApp.ViewModels.HomeIndexViewModel
@using App.Domain
@{
    ViewData["Title"] = App.Resources.Views.Home.Index.Title;
}

<div class="home-page">
    <section class="home-content">
        <div class="home-search">
            <input type="text" placeholder="@App.Resources.Views.Home.Index.SearchLocationPlaceholder" />
        </div>

        <div class="home-filters">
            <div class="home-filters-title">@App.Resources.Views.Home.Index.Filters</div>
            <div class="home-filter-row">
                <button class="filter-chip active" type="button">@App.Resources.Views.Home.Index.AvailableNow</button>
                <button class="filter-chip" type="button">@App.Resources.Views.Home.Index.FastCharging</button>
            </div>
            @if (Model.ShowVehicleFilters)
            {
                <div class="home-filters-title">
                    @App.Resources.Views.Home.Index.CompatibleWithMyVehicle
                </div>
                <div class="home-filter-row">
                    <button class="filter-chip" type="button">@App.Resources.Views.Home.Index.SelectVehicle</button>
                    @foreach (var connector in Model.ConnectorFilters)
                    {
                        <button class="filter-chip" type="button">@connector</button>
                    }
                </div>
            }
        </div>

        <div class="home-stations">
            <h2>@App.Resources.Views.Home.Index.NearbyStations</h2>

            @if (Model.Stations.Count == 0)
            {
                <div class="station-empty">
                    @App.Resources.Views.Home.Index.NoStationsFoundYet
                </div>
            }
            else
            {
                foreach (var station in Model.Stations)
                {
                    var statusText = station.Status switch
                    {
                        EStationStatus.Available => App.Resources.Views.Home.Index.StatusAvailable,
                        EStationStatus.Reserved => App.Resources.Views.Home.Index.StatusLimitedAvailability,
                        EStationStatus.InUse => App.Resources.Views.Home.Index.StatusInUse,
                        _ => App.Resources.Views.Home.Index.StatusUnavailable
                    };

                    var statusClass = station.Status switch
                    {
                        EStationStatus.Available => "status-ok",
                        EStationStatus.Reserved => "status-warn",
                        EStationStatus.InUse => "status-warn",
                        _ => "status-bad"
                    };

                    <div class="station-card">
                        <div class="station-icon">📍</div>
                        <div class="station-details">
                            <div class="station-name">@station.Name</div>
                            <div class="station-meta">📍 @station.Location | @App.Resources.Views.Home.Index.Supported: @string.Join(", ", station.ConnectorNames)</div>
                            <div class="station-status @statusClass">
                                @statusText | €@station.PricePerHour.ToString("0.00")/@App.Resources.Views.Home.Index.Hour | @App.Resources.Views.Home.Index.MaxPower: @station.MaxPower.ToString("0")kW
                            </div>
                        </div>
                        <div class="station-actions">
                            <button class="station-button" type="button">@App.Resources.Views.Home.Index.Details</button>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>

