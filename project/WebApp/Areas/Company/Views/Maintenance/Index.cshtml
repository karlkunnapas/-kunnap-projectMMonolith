@model WebApp.Areas.Company.ViewModels.MaintenanceListViewModel
@{
    var title = App.Resources.Views.Company.Maintenance.Index.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@App.Resources.Views.Company.Maintenance.Index.Heading</h2>
            <div class="vehicle-actions">
                @if (Model.CanAccessDashboard)
                {
                    <a class="filter-chip" asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companyId="@Model.CompanyId">@App.Resources.Views.Company.Maintenance.Index.BackToDashboard</a>
                }
            </div>
        </div>

        <div class="home-filter-row">
            <a class="filter-chip @(Model.IncludeResolved ? string.Empty : "active")"
               asp-area="Company" asp-controller="Maintenance" asp-action="Index"
               asp-route-companyId="@Model.CompanyId"
               asp-route-includeResolved="false">@App.Resources.Views.Company.Maintenance.Index.OpenOnly</a>
            <a class="filter-chip @(Model.IncludeResolved ? "active" : string.Empty)"
               asp-area="Company" asp-controller="Maintenance" asp-action="Index"
               asp-route-companyId="@Model.CompanyId"
               asp-route-includeResolved="true">@App.Resources.Views.Company.Maintenance.Index.AllIssues</a>
        </div>

        @if (!Model.Issues.Any())
        {
            <div class="station-empty">@App.Resources.Views.Company.Maintenance.Index.NoIssues</div>
        }
        else
        {
            @foreach (var issue in Model.Issues)
            {
                <partial name="_MaintenanceCard" model="issue" />
            }
        }
    </section>
</div>
