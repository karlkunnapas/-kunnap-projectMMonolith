@model WebApp.Areas.Company.ViewModels.CompanyStationFormViewModel
@using StationStatus = Shared.Contracts.Charging.EStationStatus
@{
    ViewData["Title"] = App.Resources.Views.Company.Station.Edit.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <h2>@App.Resources.Views.Company.Station.Edit.Heading</h2>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="station-card vehicle-form-card">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CompanyId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="vehicle-form-grid">
                <partial name="_BilingualInput" model='new WebApp.ViewModels.Shared.BilingualInputViewModel
                {
                    NameEnLabel = App.Resources.Views.Company.Station.Edit.NameEnLabel,
                    NameEtLabel = App.Resources.Views.Company.Station.Edit.NameEtLabel,
                    NameEnFieldName = nameof(Model.NameEn),
                    NameEtFieldName = nameof(Model.NameEt),
                    NameEnValue = Model.NameEn,
                    NameEtValue = Model.NameEt,
                    NameEnPlaceholder = App.Resources.Views.Company.Station.Edit.NameEnPlaceholder,
                    NameEtPlaceholder = App.Resources.Views.Company.Station.Edit.NameEtPlaceholder
                }' />
                <span data-valmsg-for="NameEn" class="text-danger"></span>
                <span data-valmsg-for="NameEt" class="text-danger"></span>

                <div class="vehicle-form-field">
                    <label asp-for="Location" class="home-filters-title">@App.Resources.Views.Company.Station.Edit.LocationLabel</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="vehicle-form-field">
                    <label asp-for="PricePerKwh" class="home-filters-title">@App.Resources.Views.Company.Station.Edit.PriceLabel</label>
                    <input asp-for="PricePerKwh" class="form-control" />
                    <span asp-validation-for="PricePerKwh" class="text-danger"></span>
                </div>
                <div class="vehicle-form-field">
                    <label asp-for="MaxPower" class="home-filters-title">@App.Resources.Views.Company.Station.Edit.MaxPowerLabel</label>
                    <input asp-for="MaxPower" class="form-control" />
                    <span asp-validation-for="MaxPower" class="text-danger"></span>
                </div>
                <div class="vehicle-form-field">
                    <label asp-for="Status" class="home-filters-title">@App.Resources.Views.Company.Station.Edit.StatusLabel</label>
                    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<StationStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <partial name="_ConnectorList" model='new WebApp.ViewModels.Shared.ConnectorChecklistViewModel
                {
                    Heading = App.Resources.Views.Company.Station.Edit.ConnectorsLabel,
                    InputName = nameof(Model.SelectedConnectorIds),
                    Items = Model.AvailableConnectors.Select(connector => new WebApp.ViewModels.Shared.ConnectorChecklistItemViewModel
                    {
                        ConnectorId = connector.ConnectorId,
                        ConnectorName = connector.ConnectorName,
                        IsAssigned = Model.SelectedConnectorIds.Contains(connector.ConnectorId)
                    }).ToList()
                }' />
            </div>

            <div class="vehicle-form-field">
                <label class="filter-chip">
                    <input asp-for="IsActive" />
                    @App.Resources.Views.Company.Station.Edit.IsActiveLabel
                </label>
            </div>

            <div class="home-filter-row">
                <button type="submit" class="station-button">@App.Resources.Views.Company.Station.Edit.SaveAction</button>
                <a asp-action="Details" asp-route-id="@Model.Id" asp-route-companyId="@Model.CompanyId" class="filter-chip">@App.Resources.Views.Company.Station.Edit.DetailsAction</a>
                <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="filter-chip">@App.Resources.Views.Company.Station.Edit.BackAction</a>
            </div>
        </form>

        <div class="station-card">
            <div class="station-details">
                <div class="station-name">@App.Resources.Views.Company.Station.Edit.ConnectorManagementHeading</div>
                <div class="home-filter-row">
                    @foreach (var connector in Model.AvailableConnectors)
                    {
                        if (connector.IsAssigned)
                        {
                            <form asp-area="Company" asp-controller="Connector" asp-action="RemoveConnector" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.CompanyId" />
                                <input type="hidden" name="stationId" value="@Model.Id" />
                                <input type="hidden" name="connectorId" value="@connector.ConnectorId" />
                                <button type="submit" class="filter-chip filter-chip-danger">@App.Resources.Views.Company.Station.Edit.RemoveConnectorAction: @connector.ConnectorName</button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Company" asp-controller="Connector" asp-action="AssignConnector" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@Model.CompanyId" />
                                <input type="hidden" name="stationId" value="@Model.Id" />
                                <input type="hidden" name="connectorId" value="@connector.ConnectorId" />
                                <button type="submit" class="filter-chip">@App.Resources.Views.Company.Station.Edit.AssignConnectorAction: @connector.ConnectorName</button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</div>
