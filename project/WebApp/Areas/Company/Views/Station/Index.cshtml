@model WebApp.Areas.Company.ViewModels.CompanyStationListViewModel
@using App.Domain
@{
    ViewData["Title"] = App.Resources.Views.Company.Station.Index.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@App.Resources.Views.Company.Station.Index.Heading</h2>
            <div class="vehicle-actions">
                <a class="station-button" asp-area="Company" asp-controller="Station" asp-action="Create" asp-route-companyId="@Model.CompanyId">@App.Resources.Views.Company.Station.Index.CreateAction</a>
                <a class="filter-chip" asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companyId="@Model.CompanyId">@App.Resources.Views.Company.Station.Index.BackToDashboard</a>
            </div>
        </div>

        @if (!Model.Stations.Any())
        {
            <div class="station-empty">@App.Resources.Views.Company.Station.Index.NoStations</div>
        }
        else
        {
            @foreach (var station in Model.Stations)
            {
                var statusClass = station.Status switch
                {
                    EStationStatus.Available => "status-ok",
                    EStationStatus.InUse => "status-warn",
                    _ => "status-bad"
                };

                <div class="station-card">
                    <div class="station-icon">⚡</div>
                    <div class="station-details">
                        <div class="station-name">@station.Name</div>
                        <div class="station-meta">@station.Location</div>
                        <div class="station-status @statusClass">@station.Status</div>
                        <div class="station-meta">@App.Resources.Views.Company.Station.Index.Connectors: @string.Join(", ", station.Connectors)</div>
                         <div class="station-meta">@App.Resources.Views.Company.Station.Index.MaintenanceIssues: @station.MaintenanceIssueCount</div>
                        <div class="station-meta">@App.Resources.Views.Company.Station.Index.PriceLabel: €@station.PricePerKwh.ToString("0.00")/kWh</div>
                        <div class="station-meta">@App.Resources.Views.Company.Station.Index.MaxPowerLabel: @station.MaxPower.ToString("0")kW</div>
                    </div>
                    <div class="station-actions">
                        <div class="home-filter-row">
                            <a class="filter-chip" asp-area="Company" asp-controller="Station" asp-action="Edit" asp-route-id="@station.Id" asp-route-companyId="@Model.CompanyId">@App.Resources.Views.Company.Station.Index.EditAction</a>
                        </div>
                        <form asp-area="Company" asp-controller="Station" asp-action="SetStatus" method="post" class="home-filter-row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="companyId" value="@Model.CompanyId" />
                            <input type="hidden" name="id" value="@station.Id" />
                            <button type="submit" class="filter-chip" name="status" value="@EStationStatus.Available">@App.Resources.Views.Company.Station.Index.SetAvailableAction</button>
                            <button type="submit" class="filter-chip" name="status" value="@EStationStatus.InUse">@App.Resources.Views.Company.Station.Index.SetInUseAction</button>
                            <button type="submit" class="filter-chip" name="status" value="@EStationStatus.Maintenance">@App.Resources.Views.Company.Station.Index.SetMaintenanceAction</button>
                        </form>
                        <a class="station-button" asp-area="Company" asp-controller="Station" asp-action="Details" asp-route-id="@station.Id" asp-route-companyId="@Model.CompanyId">
                            @App.Resources.Views.Company.Station.Index.DetailsAction
                        </a>
                        <form asp-area="Company" asp-controller="Station" asp-action="Delete" method="post" class="home-filter-row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="companyId" value="@Model.CompanyId" />
                            <input type="hidden" name="id" value="@station.Id" />
                            <button type="submit" class="filter-chip filter-chip-danger">@App.Resources.Views.Company.Station.Index.DeleteAction</button>
                        </form>
                    </div>
                </div>
            }
        }
    </section>
</div>
