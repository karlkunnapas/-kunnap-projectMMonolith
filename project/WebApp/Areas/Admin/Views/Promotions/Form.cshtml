@model WebApp.Areas.Admin.Controllers.AdminPromotionFormViewModel

@{
    var r = App.Resources.Views.Admin.Promotions.Index.ResourceManager;
    var title = Model.PromotionId.HasValue ? r.GetString("EditTitle") : r.GetString("CreateTitle");
}

<div class="admin-header mb-4">
    <h1>@title</h1>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="@(Model.PromotionId.HasValue ? "Edit" : "Create")" 
              asp-route-id="@(Model.PromotionId.HasValue ? Model.PromotionId : null)" 
              method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="Code" class="form-label">@r.GetString("PromotionCodeLabel") <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="Code" name="Code" value="@Model.Code" required />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="DiscountValue" class="form-label">@r.GetString("DiscountValueLabel") <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="number" step="0.01" min="0" class="form-control" id="DiscountValue" name="DiscountValue" value="@Model.DiscountValue" required />
                    <span class="input-group-text">€</span>
                </div>
                <span asp-validation-for="DiscountValue" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="ValidFromUtc" class="form-label">@r.GetString("ValidFromLabel") <span class="text-danger">*</span></label>
                    <input type="datetime-local" class="form-control" id="ValidFromUtc" name="ValidFromUtc" value="@Model.ValidFromUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="ValidFromUtc" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="ValidToUtc" class="form-label">@r.GetString("ValidToLabel") <span class="text-danger">*</span></label>
                    <input type="datetime-local" class="form-control" id="ValidToUtc" name="ValidToUtc" value="@Model.ValidToUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="ValidToUtc" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <input type="hidden" name="IsActive" value="false" />
                    <label class="form-check-label" for="IsActive">@r.GetString("ActiveLabel")</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <span class="bi bi-check"></span> @r.GetString("SaveLabel")
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <span class="bi bi-x"></span> @r.GetString("CancelLabel")
                </a>
            </div>
        </form>
    </div>
</div>
