@model WebApp.Areas.Admin.ViewModels.AdminAuditLogListViewModel
@{
    ViewData["Title"] = App.Resources.Views.Admin.AuditLogs.Index.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@App.Resources.Views.Admin.AuditLogs.Index.Heading</h2>
        </div>

        <form method="get" class="station-card dashboard-filter-card">
            <input type="hidden" name="page" value="1" />
            <div class="station-details reservation-form-grid vehicle-form-grid">
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.FromUtc</label>
                    <input type="datetime-local" name="fromUtc" value="@(Model.Filter.FromUtc?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
                </div>
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.ToUtc</label>
                    <input type="datetime-local" name="toUtc" value="@(Model.Filter.ToUtc?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
                </div>
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.EntityName</label>
                    <input type="text" name="entityName" value="@Model.Filter.EntityName" class="form-control" />
                </div>
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.Action</label>
                    <input type="text" name="actionFilter" value="@Model.Filter.Action" class="form-control" />
                </div>
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.Actor</label>
                    <input type="text" name="actor" value="@Model.Filter.Actor" class="form-control" />
                </div>
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.AuditLogs.Index.EntityId</label>
                    <input type="text" name="entityId" value="@Model.Filter.EntityId" class="form-control" />
                </div>
                <div class="station-actions vehicle-actions">
                    <button type="submit" class="station-button">@App.Resources.Views.Admin.AuditLogs.Index.ApplyFilters</button>
                    <a class="filter-chip" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@App.Resources.Views.Admin.AuditLogs.Index.DashboardAction</a>
                    <a class="filter-chip" asp-area="Admin" asp-controller="Companies" asp-action="Index">@App.Resources.Views.Admin.AuditLogs.Index.CompaniesAction</a>
                </div>
            </div>
        </form>

        @if (!Model.Items.Any())
        {
            <div class="station-empty">@App.Resources.Views.Admin.AuditLogs.Index.NoEntries</div>
        }
        else
        {
            <div class="station-card">
                <div class="station-details">
                    <div class="station-name">@App.Resources.Views.Admin.AuditLogs.Index.TableHeading</div>
                    <div class="operator-table">
                        <div class="operator-table-row operator-table-head">
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.AtUtc</div>
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.Action</div>
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.EntityName</div>
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.Actor</div>
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.Company</div>
                            <div>@App.Resources.Views.Admin.AuditLogs.Index.Changes</div>
                        </div>
                        @foreach (var item in Model.Items)
                        {
                            <div class="operator-table-row">
                                <div>@item.AtUtc.ToString("u")</div>
                                <div>@item.Action</div>
                                <div>@item.EntityName (@item.EntityId)</div>
                                <div>@item.UserName</div>
                                <div>@item.CompanyId</div>
                                <div>@(string.IsNullOrWhiteSpace(item.ChangesJson) ? "-" : item.ChangesJson)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="station-actions vehicle-actions">
                @if (Model.Page > 1)
                {
                    <a class="filter-chip"
                       asp-area="Admin"
                       asp-controller="AuditLogs"
                       asp-action="Index"
                       asp-route-fromUtc="@Model.Filter.FromUtc"
                       asp-route-toUtc="@Model.Filter.ToUtc"
                       asp-route-entityName="@Model.Filter.EntityName"
                       asp-route-actionFilter="@Model.Filter.Action"
                       asp-route-actor="@Model.Filter.Actor"
                       asp-route-entityId="@Model.Filter.EntityId"
                       asp-route-page="@(Model.Page - 1)">
                        @App.Resources.Views.Admin.AuditLogs.Index.PreviousPage
                    </a>
                }
                <span class="station-meta">
                    @string.Format(App.Resources.Views.Admin.AuditLogs.Index.PageSummary, Model.Page, Model.TotalPages, Model.TotalCount)
                </span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="filter-chip"
                       asp-area="Admin"
                       asp-controller="AuditLogs"
                       asp-action="Index"
                       asp-route-fromUtc="@Model.Filter.FromUtc"
                       asp-route-toUtc="@Model.Filter.ToUtc"
                       asp-route-entityName="@Model.Filter.EntityName"
                       asp-route-actionFilter="@Model.Filter.Action"
                       asp-route-actor="@Model.Filter.Actor"
                       asp-route-entityId="@Model.Filter.EntityId"
                       asp-route-page="@(Model.Page + 1)">
                        @App.Resources.Views.Admin.AuditLogs.Index.NextPage
                    </a>
                }
            </div>
        }
    </section>
</div>
