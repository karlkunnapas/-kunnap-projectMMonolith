@model WebApp.Areas.Admin.ViewModels.AdminCompanyListViewModel
@{
    var title = App.Resources.Views.Admin.Companies.Index.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@App.Resources.Views.Admin.Companies.Index.Heading</h2>
        </div>

        @if (TempData["AdminCompaniesError"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="admin-feedback admin-feedback-error">@error</div>
        }
        @if (TempData["AdminCompaniesSuccess"] is string success && !string.IsNullOrWhiteSpace(success))
        {
            <div class="admin-feedback admin-feedback-success">@success</div>
        }

        <form method="get" class="station-card dashboard-filter-card">
            <div class="station-details reservation-form-grid vehicle-form-grid">
                <div class="vehicle-form-field">
                    <label class="home-filters-title">@App.Resources.Views.Admin.Companies.Index.Search</label>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@App.Resources.Views.Admin.Companies.Index.SearchPlaceholder" />
                </div>
                <div class="station-actions vehicle-actions">
                    <button type="submit" class="station-button">@App.Resources.Views.Admin.Companies.Index.ApplySearch</button>
                    <a class="filter-chip" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@App.Resources.Views.Admin.Companies.Index.DashboardAction</a>
                    <a class="filter-chip" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">@App.Resources.Views.Admin.Companies.Index.AuditAction</a>
                </div>
            </div>
        </form>

        @if (!Model.Items.Any())
        {
            <div class="station-empty">@App.Resources.Views.Admin.Companies.Index.NoCompanies</div>
        }
        else
        {
            <div class="station-card">
                <div class="station-details">
                    <div class="station-name">@App.Resources.Views.Admin.Companies.Index.TableHeading</div>
                    <div class="operator-table">
                        <div class="operator-table-row operator-table-head">
                            <div>@App.Resources.Views.Admin.Companies.Index.Company</div>
                            <div>@App.Resources.Views.Admin.Companies.Index.Slug</div>
                            <div>@App.Resources.Views.Admin.Companies.Index.Members</div>
                            <div>@App.Resources.Views.Admin.Companies.Index.Status</div>
                            <div>@App.Resources.Views.Admin.Companies.Index.Actions</div>
                        </div>
                        @foreach (var item in Model.Items)
                        {
                            <div class="operator-table-row">
                                <div>
                                    <div class="station-name">@item.Name</div>
                                    <div class="station-meta">@item.ContactEmail</div>
                                </div>
                                <div>@item.Slug</div>
                                <div>@item.ActiveMemberCount</div>
                                <div>
                                    <span class="filter-chip">@(
                                        item.IsActive
                                            ? App.Resources.Views.Admin.Companies.Index.Active
                                            : App.Resources.Views.Admin.Companies.Index.Inactive)</span>
                                </div>
                                <div>
                                    @if (item.IsActive)
                                    {
                                        <form asp-area="Admin" asp-controller="Companies" asp-action="Deactivate" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="companyId" value="@item.CompanyId" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <button type="submit" class="station-button station-button-danger">@App.Resources.Views.Admin.Companies.Index.Inactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-area="Admin" asp-controller="Companies" asp-action="Activate" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="companyId" value="@item.CompanyId" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <button type="submit" class="station-button station-button-success">@App.Resources.Views.Admin.Companies.Index.Activate</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </section>
</div>
