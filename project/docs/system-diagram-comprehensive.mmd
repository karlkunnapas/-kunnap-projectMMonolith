classDiagram
    class IBaseEntity {
        +Guid Id
    }

    class BaseEntity {
        +Guid Id
    }

    class LangStr {
        +Guid Id
    }

    class AppUser {
        +Guid Id
        +string UserName
        +string Email
        +string PhoneNumber
        +ICollection~AppRefreshToken~ RefreshTokens
    }

    class AppRole {
        +Guid Id
        +string Name
    }

    class AppRefreshToken {
        +Guid Id
        +string RefreshToken
        +DateTime Expiration
        +string PreviousRefreshToken
        +DateTime PreviousExpiration
        +Guid UserId
    }

    class Company {
        +Guid Id
        +LangStr Name
        +string ContactEmail
        +string ContactPhone
        +string Slug
        +bool IsActive
    }

    class AuditLog {
        +Guid Id
        +Guid CompanyId
        +string UserName
        +string EntityName
        +Guid EntityId
        +string Action
        +DateTime AtUtc
        +string ChangesJson
    }

    class ChargingStation {
        +Guid Id
        +LangStr Name
        +string Location
        +EStationStatus Status
        +decimal PricePerKwh
        +decimal MaxPower
        +bool IsActive
        +Guid CompanyId
    }

    class Connector {
        +Guid Id
        +LangStr Name
        +bool IsActive
    }

    class Vehicle {
        +Guid Id
        +Guid UserId
        +string Make
        +string Model
        +decimal BatteryCapacity
    }

    class Reservation {
        +Guid Id
        +Guid UserId
        +Guid ChargingStationId
        +DateTime StartTime
        +DateTime EndTime
        +DateTime ExpiresAtUtc
        +DateTime CancelledAtUtc
        +decimal EstimatedCost
        +EReservationStatus Status
        +Guid PromotionId
    }

    class ChargingSession {
        +Guid Id
        +Guid UserId
        +Guid ChargingStationId
        +Guid ReservationId
        +Guid PromotionId
        +DateTime StartTime
        +DateTime EndTime
        +decimal EnergyConsumed
        +decimal Cost
    }

    class Maintenance {
        +Guid Id
        +Guid ChargingStationId
        +Guid ReportedByUserId
        +string IssueDescription
        +EMaintenanceStatus Status
        +DateTime ReportedAt
        +DateTime ResolvedAt
        +Guid AssignedToUserId
        +string Notes
    }

    class Promotion {
        +Guid Id
        +string Code
        +decimal DiscountValue
        +DateTime ValidFrom
        +DateTime ValidTo
        +bool IsActive
        +Guid CompanyId
    }

    class AppUserCompany {
        +Guid Id
        +Guid AppUserId
        +Guid CompanyId
        +ECompanyRole Role
        +bool IsActive
        +DateTime JoinedAtUtc
    }

    class AppUserRole {
        +Guid Id
        +Guid AppUserId
        +Guid AppRoleId
    }

    class ChargingStationConnector {
        +Guid Id
        +Guid ChargingStationId
        +Guid ConnectorId
    }

    class VehicleConnector {
        +Guid Id
        +Guid VehicleId
        +Guid ConnectorId
    }

    class UserPromotion {
        +Guid Id
        +Guid UserId
        +Guid PromotionId
        +DateTime AddedAt
        +bool IsUsed
    }

    class EStationStatus {
        Available
        InUse
        Maintenance
    }

    class EReservationStatus {
        Active
        Cancelled
        Expired
        Started
    }

    class EMaintenanceStatus {
        Reported
        InProgress
        Resolved
    }

    class ECompanyRole {
        Employee
        Manager
        Owner
    }

    IBaseEntity <|-- BaseEntity
    BaseEntity <|-- AppRefreshToken
    BaseEntity <|-- Company
    BaseEntity <|-- AuditLog
    BaseEntity <|-- ChargingStation
    BaseEntity <|-- Connector
    BaseEntity <|-- Vehicle
    BaseEntity <|-- Reservation
    BaseEntity <|-- ChargingSession
    BaseEntity <|-- Maintenance
    BaseEntity <|-- Promotion
    BaseEntity <|-- AppUserCompany
    BaseEntity <|-- AppUserRole
    BaseEntity <|-- ChargingStationConnector
    BaseEntity <|-- VehicleConnector
    BaseEntity <|-- UserPromotion
    IBaseEntity <|.. AppUser
    IBaseEntity <|.. AppRole

    Company --> AuditLog : has
    Company --> ChargingStation : owns
    Company --> Promotion : offers
    Company --> AppUserCompany : has members

    AppUser --> AppRefreshToken : has
    AppUser --> Vehicle : owns
    AppUser --> Reservation : makes
    AppUser --> ChargingSession : starts
    AppUser --> Maintenance : reports
    AppUser --> Maintenance : assigned to
    AppUser --> AppUserCompany : linked through
    AppUser --> AppUserRole : has roles
    AppUser --> UserPromotion : has

    AppRole --> AppUserRole : assigned to users

    ChargingStation --> Reservation : accepts
    ChargingStation --> ChargingSession : hosts
    ChargingStation --> Maintenance : has issues
    ChargingStation --> ChargingStationConnector : has connectors

    Connector --> ChargingStationConnector : station mapping
    Connector --> VehicleConnector : vehicle mapping
    Vehicle --> VehicleConnector : supports connectors

    Promotion --> UserPromotion : assigned to users
    Promotion --> Reservation : applied to
    Promotion --> ChargingSession : applied to

    Reservation --> ChargingSession : source for

    Company --> LangStr : Name
    ChargingStation --> LangStr : Name
    Connector --> LangStr : Name

    ChargingStation --> EStationStatus : status
    Reservation --> EReservationStatus : status
    Maintenance --> EMaintenanceStatus : status
    AppUserCompany --> ECompanyRole : role
