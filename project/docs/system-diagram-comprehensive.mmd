flowchart TB
    subgraph Entry["Entry points"]
        Browser["Browser / User"]
        Client["WebAppClient<br/>Razor MVC front-end<br/>Port 8084"]
        Backend["WebApp<br/>MVC + REST API host<br/>Port 8083"]
    end

    subgraph WebLayer["Web layer"]
        Controllers["MVC + API Controllers"]
        AppDto["App.DTO<br/>Versioned public API DTOs"]
        Swagger["Swagger / OpenAPI<br/>DTO schemas only"]
        Resources["App.Resources<br/>Localization"]
        Tenant["TenantResolutionMiddleware<br/>TenantContext"]
    end

    subgraph Boundary["Module boundary rules"]
        SharedContracts["Shared.Contracts<br/>Public module contracts and mediator messages"]
        BoundaryRule["Modules do not reference each other's DbContext, repositories, or domain internals.<br/>Cross-module relationships use IDs, module APIs, contracts, and mediator messages."]
        AuditEvent["AuditLogMutationRequested<br/>Users/Charging publish; Companies handles"]
    end

    subgraph FeatureModules["Feature modules"]
        Users["Modules.Users<br/>API: IUsersModuleApi<br/>Application: identity, profile, vehicles, tokens<br/>Domain: AppUser, AppRole, RefreshToken, Vehicle<br/>Infrastructure: UsersDbContext, UsersRepository, Users migrations"]
        Companies["Modules.Companies<br/>API: ICompaniesModuleApi<br/>Application: companies, memberships, promotions, audit<br/>Domain: Company, AppUserCompany, Promotion, UserPromotion, AuditLog<br/>Infrastructure: CompaniesDbContext, CompaniesRepository, Companies migrations"]
        Charging["Modules.Charging<br/>API: IChargingModuleApi<br/>Application: stations, connectors, reservations, sessions, maintenance, dashboard<br/>Domain: ChargingStation, Connector, Reservation, ChargingSession, Maintenance<br/>Infrastructure: ChargingDbContext, repositories, Charging migrations"]
    end

    subgraph Database["PostgreSQL database: monolith-project"]
        UsersTables["Users-owned tables<br/>AspNetUsers, AspNetRoles, RefreshTokens, Vehicles, VehicleConnectors, DataProtectionKeys"]
        CompaniesTables["Companies-owned tables<br/>Companies, AppUserCompanies, Promotions, UserPromotions, AuditLogs"]
        ChargingTables["Charging-owned tables<br/>ChargingStations, Connectors, ChargingStationConnectors, Reservations, ChargingSessions, Maintenances"]
    end

    Browser --> Client
    Browser --> Backend
    Client -- "server-side API calls" --> Backend
    Backend --> Controllers
    Controllers --> AppDto
    Controllers --> Swagger
    Controllers --> Resources
    Controllers --> Tenant

    Controllers --> SharedContracts
    SharedContracts --> Users
    SharedContracts --> Companies
    SharedContracts --> Charging
    SharedContracts --> BoundaryRule
    SharedContracts --> AuditEvent
    AuditEvent --> Companies

    Users --> UsersTables
    Companies --> CompaniesTables
    Charging --> ChargingTables

    classDef host fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#111827
    classDef web fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e3a8a
    classDef shared fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    classDef module fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b
    classDef data fill:#f8fafc,stroke:#475569,stroke-width:2px,color:#0f172a

    class Browser,Client,Backend host
    class Controllers,AppDto,Swagger,Resources,Tenant web
    class SharedContracts,BoundaryRule,AuditEvent shared
    class Users,Companies,Charging module
    class UsersTables,CompaniesTables,ChargingTables data
