erDiagram
    AppUser {
        Guid Id PK
        string UserName
        string Email
        string PhoneNumber
    }

    AppRole {
        Guid Id PK
        string Name
    }

    AppRefreshToken {
        Guid Id PK
        string RefreshToken
        DateTime Expiration
        string PreviousRefreshToken
        DateTime PreviousExpiration
        Guid UserId FK
    }

    Company {
        Guid Id PK
        LangStr Name
        string ContactEmail
        string ContactPhone
        string Slug
        bool IsActive
    }

    AuditLog {
        Guid Id PK
        Guid CompanyId FK
        string UserName
        string EntityName
        Guid EntityId
        string Action
        DateTime AtUtc
        string ChangesJson
    }

    ChargingStation {
        Guid Id PK
        LangStr Name
        string Location
        EStationStatus Status
        decimal PricePerKwh
        decimal MaxPower
        bool IsActive
        Guid CompanyId FK
    }

    Connector {
        Guid Id PK
        LangStr Name
        bool IsActive
    }

    Vehicle {
        Guid Id PK
        Guid UserId FK
        string Make
        string Model
        decimal BatteryCapacity
    }

    Reservation {
        Guid Id PK
        Guid UserId FK
        Guid ChargingStationId FK
        DateTime StartTime
        DateTime EndTime
        DateTime ExpiresAtUtc
        DateTime CancelledAtUtc
        decimal EstimatedCost
        EReservationStatus Status
        Guid PromotionId FK
    }

    ChargingSession {
        Guid Id PK
        Guid UserId FK
        Guid ChargingStationId FK
        Guid ReservationId FK
        Guid PromotionId FK
        DateTime StartTime
        DateTime EndTime
        decimal EnergyConsumed
        decimal Cost
    }

    Maintenance {
        Guid Id PK
        Guid ChargingStationId FK
        Guid ReportedByUserId FK
        string IssueDescription
        EMaintenanceStatus Status
        DateTime ReportedAt
        DateTime ResolvedAt
        Guid AssignedToUserId FK
        string Notes
    }

    Promotion {
        Guid Id PK
        string Code
        decimal DiscountValue
        DateTime ValidFrom
        DateTime ValidTo
        bool IsActive
        Guid CompanyId FK
    }

    AppUserCompany {
        Guid Id PK
        Guid AppUserId FK
        Guid CompanyId FK
        ECompanyRole Role
        bool IsActive
        DateTime JoinedAtUtc
    }

    AppUserRole {
        Guid Id PK
        Guid AppUserId FK
        Guid AppRoleId FK
    }

    ChargingStationConnector {
        Guid Id PK
        Guid ChargingStationId FK
        Guid ConnectorId FK
    }

    VehicleConnector {
        Guid Id PK
        Guid VehicleId FK
        Guid ConnectorId FK
    }

    UserPromotion {
        Guid Id PK
        Guid UserId FK
        Guid PromotionId FK
        DateTime AddedAt
        bool IsUsed
    }

    AppUser ||--o{ AppRefreshToken : has
    AppUser ||--o{ Vehicle : owns
    AppUser ||--o{ Reservation : makes
    AppUser ||--o{ ChargingSession : starts
    AppUser o|--o{ Maintenance : reports
    AppUser o|--o{ Maintenance : assigned_to
    AppUser ||--o{ AppUserCompany : linked_to
    AppUser ||--o{ AppUserRole : has_roles
    AppUser ||--o{ UserPromotion : has

    AppRole ||--o{ AppUserRole : assigned_to_users

    Company o|--o{ ChargingStation : owns
    Company o|--o{ Promotion : offers
    Company ||--o{ AppUserCompany : has_members
    Company ||--o{ AuditLog : has_audit_entries

    ChargingStation ||--o{ Reservation : accepts
    ChargingStation ||--o{ ChargingSession : hosts
    ChargingStation ||--o{ Maintenance : has_issues
    ChargingStation ||--o{ ChargingStationConnector : has

    Connector ||--o{ ChargingStationConnector : station_compatibility
    Connector ||--o{ VehicleConnector : vehicle_compatibility
    Vehicle ||--o{ VehicleConnector : has

    Promotion o|--o{ Reservation : applies_to
    Promotion o|--o{ ChargingSession : applies_to
    Promotion ||--o{ UserPromotion : assigned_to_users

    Reservation o|--o{ ChargingSession : source_for
