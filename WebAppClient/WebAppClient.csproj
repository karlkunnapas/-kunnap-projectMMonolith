<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Areas/Root/Controllers/UsersController.cs" />
        <Compile Remove="Areas/Root/ViewModels/PasswordLinkViewModel.cs" />
        <Compile Remove="App.Resources/obj/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="Areas/Root/Views/Users/**" />
        <Content Remove="App.Resources/obj/**" />
        <EmbeddedResource Remove="App.Resources/obj/**" />
    </ItemGroup>

</Project>
