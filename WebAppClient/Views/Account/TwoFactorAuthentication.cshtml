@model WebApp.ViewModels.Account.TwoFactorViewModel
@{
    var r = App.Resources.Views.Shared._Layout.ResourceManager;
    var title = r.GetString("TwoFactorAuthentication");
}

<h1>@title</h1>

@if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-info" role="alert">@statusMessage</div>
}

@if (TempData["RecoveryCodes"] is string recoveryCodes && !string.IsNullOrWhiteSpace(recoveryCodes))
{
    <div class="alert alert-warning" role="alert">
        <strong>@r.GetString("RecoveryCodesPrompt")</strong>
        <pre class="mt-2 mb-0">@recoveryCodes</pre>
    </div>
}

<div class="mb-3">
    <strong>@r.GetString("TwoFactorEnabled")</strong> @(Model.IsTwoFactorEnabled ? r.GetString("Yes") : r.GetString("No"))<br />
    <strong>@r.GetString("RecoveryCodesLeft")</strong> @Model.RecoveryCodesLeft
</div>

@if (!Model.IsTwoFactorEnabled)
{
    @if (string.IsNullOrWhiteSpace(Model.SharedKey))
    {
        <form asp-action="BeginTwoFactorSetup" method="post">
            <button type="submit" class="btn btn-primary">@r.GetString("SetUpAuthenticatorApp")</button>
        </form>
    }
    else
    {
        <div class="alert alert-secondary" role="alert">
            <div><strong>@r.GetString("SharedKey")</strong> @Model.SharedKey</div>
            <div class="mt-2"><strong>@r.GetString("AuthenticatorUri")</strong> <code>@Model.AuthenticatorUri</code></div>
        </div>

        <form asp-action="EnableTwoFactor" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SharedKey" />
            <input type="hidden" asp-for="AuthenticatorUri" />
            <div class="mb-3">
                <label asp-for="VerificationCode" class="form-label"></label>
                <input asp-for="VerificationCode" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success">@r.GetString("EnableTwoFactor")</button>
        </form>
    }
}
else
{
    <div class="d-flex gap-2 flex-wrap">
        <form asp-action="RegenerateRecoveryCodes" method="post">
            <button type="submit" class="btn btn-outline-primary">@r.GetString("RegenerateRecoveryCodes")</button>
        </form>
        <form asp-action="DisableTwoFactor" method="post">
            <button type="submit" class="btn btn-outline-danger">@r.GetString("DisableTwoFactor")</button>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
