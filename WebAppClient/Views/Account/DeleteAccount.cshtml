@model WebApp.ViewModels.Account.DeleteAccountViewModel
@{
    ViewData["Title"] = "Delete Account";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger" role="alert">
    This action permanently deletes your account.
</div>

<form asp-action="DeleteAccount" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Confirm Password</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger">Delete My Account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
