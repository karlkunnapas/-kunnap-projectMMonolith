@{
    var title = App.Resources.Views.Account.CompanyDeactivated.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@title</h2>
        </div>

        <article class="station-card">
            <div class="station-details">
                <div class="station-name">@App.Resources.Views.Account.CompanyDeactivated.Heading</div>
                <p class="station-meta mb-0">@App.Resources.Views.Account.CompanyDeactivated.Message</p>
            </div>
        </article>
    </section>
</div>
