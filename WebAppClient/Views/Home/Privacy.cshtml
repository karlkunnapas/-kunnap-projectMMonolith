@using System.Threading
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment WebHostEnvironment
@{
    var r = App.Resources.Views.Shared._Layout.ResourceManager;
    var title = r.GetString("PrivacyPolicy");
}
<h1>@title</h1>


<p>@r.GetString("NoPrivacy")</p>


<h3>@r.GetString("Environment") - @(WebHostEnvironment.EnvironmentName)</h3>

<h3>@r.GetString("Ip")</h3>
<ul>
    <li>@r.GetString("RemoteIp") @Context.Connection.RemoteIpAddress</li>
    <li>@r.GetString("LocalIp") @Context.Connection.LocalIpAddress</li>
</ul>


<h3>@r.GetString("Culture")</h3>
<ul>
    <li>@r.GetString("CurrentCulture") @Thread.CurrentThread.CurrentCulture.Name</li>
    <li>@r.GetString("CurrentUiCulture") @Thread.CurrentThread.CurrentUICulture.Name</li>
</ul>


<h3>@r.GetString("Claims")</h3>
<table class="table">

    <thead>
    <tr>
        <th>@r.GetString("Type")</th>
        <th>@r.GetString("Value")</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var userClaim in User.Claims)
    {
        <tr>
            <td>
                @userClaim.Type
            </td>
            <td>
                @userClaim.Value
            </td>
        </tr>
    }
    </tbody>
</table>


<h3>@r.GetString("Headers")</h3>
<ul>
    @foreach (var header in Context.Request.Headers)
    {
        foreach (var stringValue in header.Value)
        {
            <li>@header.Key - @stringValue</li>
        }
    }
</ul>
