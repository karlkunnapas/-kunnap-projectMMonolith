@model WebApp.ViewModels.HomeIndexViewModel
@using System
@{
    var title = App.Resources.Views.Home.Index.Title;
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SelectedStatus)
                           || !string.IsNullOrWhiteSpace(Model.SelectedConnector)
                           || !string.IsNullOrWhiteSpace(Model.LocationQuery)
                           || Model.SelectedVehicleId.HasValue;
}

<div class="home-page">
    <section class="home-content">
        <form class="home-search" method="get" asp-controller="Home" asp-action="Index">
            <input type="text" name="location" value="@Model.LocationQuery" placeholder="@App.Resources.Views.Home.Index.SearchLocationPlaceholder" />
            @if (!string.IsNullOrWhiteSpace(Model.SelectedStatus))
            {
                <input type="hidden" name="status" value="@Model.SelectedStatus" />
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedConnector))
            {
                <input type="hidden" name="connector" value="@Model.SelectedConnector" />
            }
            @if (Model.SelectedVehicleId.HasValue)
            {
                <input type="hidden" name="vehicleId" value="@Model.SelectedVehicleId" />
            }
        </form>

        <div class="home-filters">
            <div class="home-filters-title">@App.Resources.Views.Home.Index.Filters</div>
            <div class="home-filter-row">
                <a class="filter-chip @(string.Equals(Model.SelectedStatus, EStationStatus.Available.ToString(), StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-status="@EStationStatus.Available"
                   asp-route-location="@Model.LocationQuery"
                   asp-route-connector="@Model.SelectedConnector"
                   asp-route-vehicleId="@Model.SelectedVehicleId">
                    @App.Resources.Views.Home.Index.AvailableNow
                </a>
                @if (hasActiveFilters)
                {
                    <a class="filter-chip"
                       asp-controller="Home"
                       asp-action="Index">
                        @App.Resources.Views.Home.Index.ClearFilters
                    </a>
                }
            </div>
            @if (Model.ShowVehicleFilters)
            {
                <div class="home-filters-title">
                    @App.Resources.Views.Home.Index.CompatibleWithMyVehicle
                </div>
                <div class="home-filter-row">
                    <a class="filter-chip" asp-area="Root" asp-controller="Vehicle" asp-action="Index">
                        @App.Resources.Views.Home.Index.SelectVehicle
                    </a>
                    @if (Model.VehicleOptions.Count > 0)
                    {
                        <form method="get" asp-controller="Home" asp-action="Index" class="d-inline">
                            <input type="hidden" name="status" value="@Model.SelectedStatus" />
                            <input type="hidden" name="connector" value="@Model.SelectedConnector" />
                            <input type="hidden" name="location" value="@Model.LocationQuery" />
                            <select name="vehicleId" class="home-vehicle-select" onchange="this.form.submit()">
                                <option value="">@App.Resources.Views.Home.Index.AllVehicles</option>
                                @foreach (var vehicle in Model.VehicleOptions)
                                {
                                    if (Model.SelectedVehicleId == vehicle.Id)
                                    {
                                        <option value="@vehicle.Id" selected>@vehicle.DisplayName</option>
                                    }
                                    else
                                    {
                                        <option value="@vehicle.Id">@vehicle.DisplayName</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                    @foreach (var connector in Model.ConnectorFilters)
                    {
                        <a class="filter-chip @(string.Equals(Model.SelectedConnector, connector, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-status="@Model.SelectedStatus"
                           asp-route-location="@Model.LocationQuery"
                           asp-route-vehicleId="@Model.SelectedVehicleId"
                           asp-route-connector="@connector">
                            @connector
                        </a>
                    }
                </div>
            }
        </div>

        <div class="home-stations">
            <h2>@App.Resources.Views.Home.Index.NearbyStations</h2>

            @if (Model.Stations.Count == 0)
            {
                <div class="station-empty">
                    @App.Resources.Views.Home.Index.NoStationsFoundYet
                </div>
            }
            else
            {
                foreach (var station in Model.Stations)
                {
                    <partial name="_StationCard" model="station" />
                }
            }
        </div>
    </section>
</div>
