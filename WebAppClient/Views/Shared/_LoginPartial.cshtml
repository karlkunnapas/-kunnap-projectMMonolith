@if (User.Identity?.IsAuthenticated == true)
{
    <li class="app-nav-item">
        <a asp-area="" asp-controller="Account" asp-action="Manage" title="Manage">@App.Resources.Views.Shared._Layout.Hello @User.Identity?.Name!</a>
    </li>
    <li class="app-nav-item">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="app-nav-link-button">@App.Resources.Views.Shared._Layout.Logout</button>
        </form>
    </li>
}
else
{
    <li class="app-nav-item">
        <a asp-area="" asp-controller="Account" asp-action="Register">@App.Resources.Views.Shared._Layout.Register</a>
    </li>
    <li class="app-nav-item">
        <a asp-area="Company" asp-controller="Account" asp-action="Register">@App.Resources.Views.Account.Register.RegisterCompany</a>
    </li>
    <li class="app-nav-item">
        <a asp-area="" asp-controller="Account" asp-action="Login">@App.Resources.Views.Shared._Layout.Login</a>
    </li>
}
