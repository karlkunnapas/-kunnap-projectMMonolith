@model WebApp.ViewModels.ErrorViewModel
@{
    var r = App.Resources.Views.Shared._Layout.ResourceManager;
    var title = r.GetString("ErrorTitle");
}

<h1 class="text-danger">@r.GetString("ErrorHeading")</h1>
<h2 class="text-danger">@r.GetString("ErrorMessage")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@r.GetString("RequestId")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@r.GetString("DevelopmentMode")</h3>
<p>
    @r.GetString("DevelopmentModeMessage")
</p>
<p>
    <strong>@r.GetString("DevelopmentModeWarning")</strong>
    @r.GetString("DevelopmentModeHint")
</p>
