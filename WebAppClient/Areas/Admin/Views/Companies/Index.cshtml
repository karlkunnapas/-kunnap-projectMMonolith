@model IEnumerable<WebApp.Areas.Admin.ViewModels.CompanyAdminViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slug)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item?.Name ?? string.Empty)
            </td>
            <td>
                @(item?.ContactEmail ?? string.Empty)
            </td>
            <td>
                @(item?.ContactPhone ?? string.Empty)
            </td>
            <td>
                @(item?.Slug ?? string.Empty)
            </td>
            <td>
                @(item?.IsActive.ToString() ?? string.Empty)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item?.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item?.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item?.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
