@model App.Domain.Maintenance

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Maintenance</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ChargingStationId" class="control-label"></label>
                <select asp-for="ChargingStationId" class="form-control" asp-items="ViewBag.ChargingStationId"></select>
                <span asp-validation-for="ChargingStationId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReportedByUserId" class="control-label"></label>
                <select asp-for="ReportedByUserId" class="form-control" asp-items="ViewBag.ReportedByUserId"></select>
                <span asp-validation-for="ReportedByUserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IssueDescription" class="control-label"></label>
                <input asp-for="IssueDescription" class="form-control" />
                <span asp-validation-for="IssueDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<App.Domain.EMaintenanceStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReportedAt" class="control-label"></label>
                <input asp-for="ReportedAt" class="form-control" />
                <span asp-validation-for="ReportedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ResolvedAt" class="control-label"></label>
                <input asp-for="ResolvedAt" class="form-control" />
                <span asp-validation-for="ResolvedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AssignedToUserId" class="control-label"></label>
                <select asp-for="AssignedToUserId" class="form-control" asp-items="ViewBag.AssignedToUserId"></select>
                <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
