@model IEnumerable<App.Domain.UserPromotion>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AddedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsUsed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Promotion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item?.AddedAt.ToString() ?? string.Empty)
            </td>
            <td>
                @(item?.IsUsed.ToString() ?? string.Empty)
            </td>
            <td>
                @(item?.User?.Id.ToString() ?? string.Empty)
            </td>
            <td>
                @(item?.Promotion?.Code ?? string.Empty)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item?.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item?.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item?.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
