@model WebApp.Areas.Company.ViewModels.OperatorDashboardViewModel
@{
    var title = App.Resources.Views.Company.Dashboard.MaintenanceQueue.Title;
}

<div class="home-page reservation-page">
    <section class="home-content">
        <div class="vehicle-header-row">
            <h2>@App.Resources.Views.Company.Dashboard.MaintenanceQueue.Heading</h2>
            <div class="vehicle-actions">
                <a class="filter-chip" asp-area="Company" asp-controller="Dashboard" asp-action="Index" asp-route-companyId="@Model.CompanyId">@App.Resources.Views.Company.Dashboard.MaintenanceQueue.BackToDashboard</a>
            </div>
        </div>

        @if (!Model.MaintenanceQueue.Any())
        {
            <div class="station-empty">@App.Resources.Views.Company.Dashboard.MaintenanceQueue.NoIssues</div>
        }
        else
        {
            <div class="station-card">
                <div class="station-details">
                    @foreach (var issue in Model.MaintenanceQueue)
                    {
                        <partial name="_MaintenanceCard" model="issue" />
                    }
                </div>
            </div>
        }
    </section>
</div>
