@using App.Domain.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.EntityFrameworkCore
@model List<App.Domain.Identity.AppUser>
@inject UserManager<AppUser> UserManager
@inject RoleManager<AppRole> RoleManager

@{
    var r = App.Resources.Views.Shared._Layout.ResourceManager;
    var title = r.GetString("Users");

    var allRoles = await RoleManager.Roles.OrderBy(role => role.Name).ToListAsync();
}

<h1>@title</h1>

<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model[0].UserName)
        </th>
        <th>@r.GetString("Roles")</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var userRoles = await UserManager.GetRolesAsync(item);
        <tr>
            <td>@Html.DisplayFor(modelItem => item.UserName)</td>
            <td>
                <ul>
                    @foreach (var role in allRoles)
                    {
                        <li>
                            @role.Name
                            @if (userRoles.Any(r => r == role.Name))
                            {
                                <a asp-action="RoleRemove" asp-route-userId="@item.Id" asp-route-role="@role">@r.GetString("Remove")</a>
                            }
                            else
                            {
                                <a asp-action="RoleAdd" asp-route-userId="@item.Id" asp-route-role="@role">@r.GetString("Add")</a>
                            }
                        </li>
                    }
                </ul>
            </td>
            <td>
                <a asp-action="PasswordLink" asp-route-id="@item.Id">@r.GetString("ResetPassword")</a>
            </td>
        </tr>
    }
    </tbody>
</table>
